{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"strict": false,
		"jsx": "preserve",
		"jsxImportSource": "vue",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"types": ["vite/client", "node"],
		"baseUrl": ".",
		"paths": {
			"lmUtils": ["packages/utils/index.ts"],
			"lmUtils/*": ["packages/utils/*"],
			"lmLibs/*": ["packages/libs/*"],
			"lmStore/*": ["packages/store/*"],
			"lmHooks/*": ["packages/hooks/*"],
			"lmIreposC/*": ["packages/irepos/c/*"],
			"lmIreposC": ["packages/irepos/c/index.ts"],
			"lmIreposF/*": ["packages/irepos/f/*"],
			"lmIreposF": ["packages/irepos/f/index.ts"],
			"lmCmpsBasic/*": ["packages/cmps/basic/*"],
			"lmCmpsBiz/*": ["packages/cmps/biz/*"],
			"lmCmpsLayout/*": ["packages/cmps/layout/*"],
			"lmCmpsEcharts/*": ["packages/cmps/echarts/*"],
			"lmApisCampus/*": ["packages/apis/campus/*"],
			"lmPureai/*": ["packages/pureai/*"],
			"lmAppsCampusEntry/*": ["packages/apps/campus/entry/*"],
			"lmAppsCampusMdusLogin/*": ["packages/apps/campus/mdus/login/*"],
			"lmAppsCampusMdusHome/*": ["packages/apps/campus/mdus/home/*"],
			"lmAppsCampusMdusXsgl/*": ["packages/apps/campus/mdus/xsgl/*"],
			"lmAppsCampusMdusJsgl/*": ["packages/apps/campus/mdus/jsgl/*"],
			"lmAppsCampusMdusBjgl/*": ["packages/apps/campus/mdus/bjgl/*"],
			"lmAppsCampusMdusKcgl/*": ["packages/apps/campus/mdus/kcgl/*"],
			"lmAppsCampusMdusKcb/*": ["packages/apps/campus/mdus/kcb/*"],
			"lmAppsCampusMdusKqgl/*": ["packages/apps/campus/mdus/kqgl/*"],
			"lmAppsCampusMdusCjgl/*": ["packages/apps/campus/mdus/cjgl/*"],
			"lmAppsCampusMdusSsgl/*": ["packages/apps/campus/mdus/ssgl/*"],
			"lmAppsCampusMdusYkt/*": ["packages/apps/campus/mdus/ykt/*"],
			"lmAppsCampusMdusMjgl/*": ["packages/apps/campus/mdus/mjgl/*"],
			"lmAppsCampusMdusTzgg/*": ["packages/apps/campus/mdus/tzgg/*"],
			"lmAppsCampusMdusAi/*": ["packages/apps/campus/mdus/ai/*"],
			"lmAppsCampusMdusXtgl/*": ["packages/apps/campus/mdus/xtgl/*"],
			"@/*": ["packages/apps/campus/entry/*"]
		}
	},
	"include": [
		"packages/**/*.ts",
		"packages/**/*.tsx",
		"packages/**/*.vue",
		"packages/**/*.d.ts",
		"vite.config.ts",
		"types/**/*.d.ts"
	],
	"exclude": ["node_modules", "dist"]
}

