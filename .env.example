# ⚠️ 这是模板文件（需要提交到仓库），只写变量名和示例值。
#    真实密钥请写进 .env.local（已被 .gitignore 的 *.local 忽略），本文件保持留空。
#    Vite 只会加载 .env / .env.local / .env.[mode] / .env.[mode].local，不会加载本文件。

# ---------- 数据 ----------
# 是否启用本地 mock 服务（设为 false 时请求真实后端）
VITE_USE_MOCK=true
# 接口前缀：默认同源 /api/；独立部署后端时可填 http://127.0.0.1:3001/api/
VITE_API_BASE=/api/

# ---------- AI 引擎 ----------
# rule：本地规则引擎（默认，无需任何依赖）
# openai：任意 OpenAI 兼容服务   ollama：本地 Ollama
VITE_AI_PROVIDER=rule
# 填「接口里的 model id」，不是控制台的展示名
VITE_AI_MODEL=gpt-4o-mini
# 前端只请求代理地址，不要填真实模型地址
VITE_AI_BASE=/ai-proxy

# ---------- AI 代理（仅服务端读取，切勿加 VITE_ 前缀） ----------
# 例：https://api.deepseek.com/v1 或 http://127.0.0.1:11434
AI_UPSTREAM_BASE=
# 上游密钥（本地 Ollama 可留空）
# ⚠️ 这里保持留空！真实 Key 写 .env.local，不要把 sk- 开头的串提交上来
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# 已知可用的 model id 示例：
#   DeepSeek：deepseek-flash / deepseek-v4-pro
#   OpenAI  ：gpt-4o-mini / gpt-4o
# 不确定时：GET {AI_UPSTREAM_BASE}/models 可以列出可用 id
